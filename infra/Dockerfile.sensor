# One image for every sensor archetype. Build from the repository root:
#   docker build -f infra/Dockerfile.sensor --build-arg ARCHETYPE=support -t tripvane-sensor:support .
# ARCHETYPE names a package under tripvane_sensors.archetypes whose app module has create_app().

FROM python:3.12-slim-bookworm AS build
RUN pip install --no-cache-dir uv==0.11.33
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /src
COPY pyproject.toml uv.lock .python-version ./
COPY packages ./packages
RUN uv sync --locked --no-dev --no-editable --package tripvane-sensors

FROM python:3.12-slim-bookworm
ARG ARCHETYPE
ENV ARCHETYPE=${ARCHETYPE} \
    PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1
COPY --from=build /app/.venv /app/.venv
RUN test -n "$ARCHETYPE" \
    && python -c "import importlib, sys; importlib.import_module(f'tripvane_sensors.archetypes.{sys.argv[1]}.app')" "$ARCHETYPE" \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin sensor \
    && mkdir -p /var/spool/tripvane \
    && chown sensor:sensor /var/spool/tripvane
USER sensor
WORKDIR /app
EXPOSE 8080
# X-Forwarded-For is handled by the app (TRUSTED_PROXY), so uvicorn must not rewrite the
# client address. No access log: events are the only record of a request.
CMD ["sh", "-c", "exec uvicorn \"tripvane_sensors.archetypes.${ARCHETYPE}.app:create_app\" --factory --host 0.0.0.0 --port 8080 --no-proxy-headers --no-access-log --no-server-header"]
